{
  "appId": "com.auramusic.player",
  "productName": "AuraMusic",
  "directories": {
    "output": "dist-release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": ["portable"]
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  }
}
